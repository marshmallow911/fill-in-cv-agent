# OpenAI-compatible model configuration. The API key is local plaintext;
# this file is only a template, while .env is ignored by Git.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5-mini
MODEL_API_KEY=your-local-api-key
MODEL_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low

CAREER_OPS_PATH=~/career-ops
# Optional: false keeps the existing step-by-step Agent; true enables batch prefill.
# Maximum concurrent read-only field mappers (1-4). Browser writes stay sequential.
BROWSERAGENT_MAPPING_PARALLELISM=3

# Optional higher-priority aliases:
# BROWSERAGENT_LLM_PROVIDER=openai
# BROWSERAGENT_LLM_MODEL=gpt-5-mini
# BROWSERAGENT_LLM_API_KEY=your-local-api-key
# BROWSERAGENT_LLM_BASE_URL=https://api.openai.com/v1
# BROWSERAGENT_REASONING_EFFORT=low
